<ArcGIS defaultAssembly="ArcGisProMcpFree.dll" defaultNamespace="ArcGisProMcpFree" xmlns="http://schemas.esri.com/DADF/Registry" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://schemas.esri.com/DADF/Registry file:///C:/Program%20Files/ArcGIS/Pro/bin/ArcGIS.Desktop.Framework.xsd">
  <AddInInfo id="{59c64cb3-4493-4270-8a30-43b67c25e82e}" version="0.2.3" desktopVersion="3.5">
    <Name>GIS 实验 MCP</Name>
    <Description>Native toolbox dialogs, geoprocessing, and experiment evidence. ArcGIS Pro 3.5.</Description>
    <Image>Images\mcp_red32.png</Image>
    <Author>IngKevin</Author>
    <Company>IngKevin</Company>
    <Date>2026-09-04</Date>
    <Subject>GIS, Developer Tools, MCP, ArcGIS Pro</Subject>
  </AddInInfo>

  <modules>
    <!-- The module loads with Pro, but the pipe server only starts when the
         user presses Start in the control window. Nothing listens on its own. -->
    <insertModule id="ArcGisProMcpFree_Module" className="Module1" autoLoad="true" caption="GIS 实验 MCP Module">
      <tabs>
        <tab id="ArcGisProMcpFree_Tab" caption="GIS 实验 MCP">
          <group refID="ArcGisProMcpFree_Group" />
        </tab>
      </tabs>

      <groups>
        <group id="ArcGisProMcpFree_Group" caption="GIS 实验 MCP" appearsOnAddInTab="false">
          <button refID="ArcGisProMcpFree_ControlButton" size="large" />
        </group>
      </groups>

      <controls>
        <button id="ArcGisProMcpFree_ControlButton" caption="GIS 实验 MCP" className="BridgeControlButton" loadOnClick="true"
                smallImage="Images\mcp_red16.png" largeImage="Images\mcp_red32.png">
          <tooltip heading="GIS 实验 MCP">
            打开连接面板，启动或停止本机 MCP 服务。默认端口为 5876。
          </tooltip>
        </button>
      </controls>
    </insertModule>
  </modules>
</ArcGIS>

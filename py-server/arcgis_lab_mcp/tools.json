  {
    "name": "arcgis_create_feature",
    "description": "通过原生编辑操作创建点、单部件折线或闭合多边形，并按目标图层坐标系投影。保存操作前后截图。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "layer_name": {
          "title": "Layer Name",
          "type": "string"
        },
        "wkid": {
          "title": "Wkid",
          "type": "integer",
          "minimum": 1
        },
        "attributes": {
          "title": "Attributes",
          "additionalProperties": true,
          "type": "object"
        },
        "evidence_dir": {
          "type": "string",
          "description": "Absolute screenshot/log folder. Defaults to ARCGIS_LAB_EVIDENCE_DIR."
        },
        "step_title": {
          "type": "string",
          "description": "Short label for this experiment step."
        },
        "geometry": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "Point"
                },
                "coordinates": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "required": [
                "type",
                "coordinates"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "Polyline"
                },
